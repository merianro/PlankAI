# PlankAI Environment Variables
# Copy this file to .env and fill in the values

# OpenAI API key (required for AI fallback vision)
PLANKAI_OPENAI_API_KEY=

# Vision model to use (default: gpt-5.6-luna)
PLANKAI_VISION_MODEL=gpt-5.6-luna

# OCR engine: tesseract or easyocr
PLANKAI_OCR_ENGINE=tesseract

# SQLite database URL
PLANKAI_DATABASE_URL=sqlite:///data/corrections.db

# Telegram bot token (required for bot mode)
PLANKAI_TELEGRAM_TOKEN=
